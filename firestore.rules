rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection health check document
    match /test/connection {
      allow read: if true;
    }

    // 1. Private User Profiles (users/{userId})
    // Strictly private: only the owner can read or write their private account profile.
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying users collection directly to protect privacy
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 1
                    && request.resource.data.fullName.size() <= 150;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']))
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 1;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Public / Matchmaking Profiles (publicProfiles/{userId})
    // Safe for matchmaking: any authenticated student can read/list available practice partners.
    // Only the owner can create/update/delete their own matching card.
    // Strictly forbidden from containing PII like email, password, or private progress.
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && !('email' in request.resource.data)
                    && !('password' in request.resource.data)
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 1
                    && request.resource.data.displayName.size() <= 150;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && !('email' in request.resource.data)
                    && !('password' in request.resource.data)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']))
                    && request.resource.data.displayName is string;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 3. Peer Feedback (peerFeedback/{feedbackId})
    // Created by authenticated student who completed a room practice session.
    // Read allowed only to recipient (toStudentUid) or creator (fromStudentUid).
    match /peerFeedback/{feedbackId} {
      allow get: if isSignedIn() && isValidId(feedbackId) &&
                 (resource.data.toStudentUid == request.auth.uid || resource.data.fromStudentUid == request.auth.uid);
      allow list: if isSignedIn() &&
                  (resource.data.toStudentUid == request.auth.uid || resource.data.fromStudentUid == request.auth.uid);
      allow create: if isSignedIn()
                    && isValidId(feedbackId)
                    && request.resource.data.fromStudentUid == request.auth.uid
                    && request.resource.data.ratings is map;
      allow update: if false; // Peer reviews cannot be altered after creation
      allow delete: if isSignedIn() && resource.data.fromStudentUid == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

